<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>Arca.Core</RootNamespace>
    <AssemblyName>Arca.Core</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>0.1.0</Version>
    <Authors>Stephen Stirling</Authors>
    <Company>Stephen Stirling</Company>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Arca.Core.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Reads ZIP, 7z, RAR/RAR5, TAR (+gz/bz2/xz) in managed code. RAR is read with SharpCompress's own
         reader, so no RARLAB UnRAR source or licence terms come into it. -->
    <PackageReference Include="SharpCompress" Version="0.38.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- 7-Zip's command-line program, for creating 7z and password-protected archives (see third-party/7-Zip/README.md).
         Copied into a "7-Zip" folder beside every program that uses this library: Arca itself and the tests. -->
    <None Include="..\..\third-party\7-Zip\7za.exe;..\..\third-party\7-Zip\License.txt"
          Link="7-Zip\%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
