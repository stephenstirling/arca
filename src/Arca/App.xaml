<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="Arca.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Placeholder accent (warm amber) until the suite's design pass; replace the seven shades together. -->
            <Color x:Key="SystemAccentColor">#D6963C</Color>
            <Color x:Key="SystemAccentColorLight1">#E0A552</Color>
            <Color x:Key="SystemAccentColorLight2">#E8B46A</Color>
            <Color x:Key="SystemAccentColorLight3">#F0C484</Color>
            <Color x:Key="SystemAccentColorDark1">#B97D2A</Color>
            <Color x:Key="SystemAccentColorDark2">#9A6620</Color>
            <Color x:Key="SystemAccentColorDark3">#7B5018</Color>
        </ResourceDictionary>
    </Application.Resources>
</Application>
